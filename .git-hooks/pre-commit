#!/bin/bash
# Pre-commit hook to prevent committing broken code
# Install: cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any checks failed
FAILED=0

# 1. Check for Python syntax errors
echo "  • Checking Python syntax..."
if python -m py_compile app/**/*.py 2>/dev/null || true; then
    echo -e "${GREEN}  ✓ Python syntax OK${NC}"
else
    echo -e "${RED}  ✗ Python syntax errors found${NC}"
    FAILED=1
fi

# 2. Check imports can be resolved
echo "  • Checking imports..."
if python -c "from app import app, db; from app.models import *; print('✓ Imports OK')" 2>/dev/null; then
    echo -e "${GREEN}  ✓ All imports resolvable${NC}"
else
    echo -e "${RED}  ✗ Import errors detected${NC}"
    FAILED=1
fi

# 3. Run quick unit tests
echo "  • Running quick unit tests..."
if python -m pytest tests/test_accurate_comprehensive.py -q --tb=no 2>/dev/null; then
    echo -e "${GREEN}  ✓ Unit tests passed${NC}"
else
    echo -e "${RED}  ✗ Unit tests failed${NC}"
    FAILED=1
fi

# 4. Run route-level tests (if they exist)
echo "  • Running route-level tests..."
if python -m pytest tests/test_kiv_visibility_fix.py -q --tb=no 2>/dev/null; then
    echo -e "${GREEN}  ✓ Route tests passed${NC}"
else
    echo -e "${YELLOW}  ⚠ Route tests not available yet${NC}"
fi

# 5. Check for uncommitted changes in critical files
echo "  • Checking critical file modifications..."
CRITICAL_FILES=("app/routes.py" "app/models.py" "tests/test_*.py")
for file in "${CRITICAL_FILES[@]}"; do
    if git diff --cached --name-only | grep -q "$file"; then
        echo -e "${YELLOW}  ⚠ Modified: $file (ensure tests were run)${NC}"
    fi
done

# Final result
echo ""
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-commit checks passed - commit allowed${NC}"
    exit 0
else
    echo -e "${RED}❌ Pre-commit checks failed - commit blocked${NC}"
    echo ""
    echo "💡 To fix:"
    echo "  1. Review the errors above"
    echo "  2. Run: pytest tests/ -v"
    echo "  3. Fix any issues"
    echo "  4. Try committing again"
    echo ""
    echo "⚠️  To skip (NOT RECOMMENDED): git commit --no-verify"
    exit 1
fi
