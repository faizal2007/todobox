#!/bin/bash
# Pre-commit hook to prevent committing broken code
# Install: cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Track if any checks failed
FAILED=0

# 1. Check for Python syntax errors
echo "  • Checking Python syntax..."
if python -m py_compile app/**/*.py 2>/dev/null || true; then
    echo -e "${GREEN}  ✓ Python syntax OK${NC}"
else
    echo -e "${RED}  ✗ Python syntax errors found${NC}"
    FAILED=1
fi

# 2. Check imports can be resolved
echo "  • Checking imports..."
if python -c "from app import app, db; from app.models import *; from app.routes import *; from app.forms import *; print('✓ Imports OK')" 2>/dev/null; then
    echo -e "${GREEN}  ✓ All imports resolvable${NC}"
else
    echo -e "${RED}  ✗ Import errors detected${NC}"
    FAILED=1
fi

# 3. Validate requirements.txt
echo "  • Validating requirements.txt..."
if python scripts/validate_requirements.py 2>/dev/null; then
    echo -e "${GREEN}  ✓ Requirements validation passed${NC}"
else
    echo -e "${RED}  ✗ Requirements validation failed${NC}"
    FAILED=1
fi

# 4. Run quick unit tests
echo "  • Running quick unit tests..."
if python -m pytest tests/test_accurate_comprehensive.py -q --tb=no 2>/dev/null; then
    echo -e "${GREEN}  ✓ Unit tests passed${NC}"
else
    echo -e "${RED}  ✗ Unit tests failed${NC}"
    FAILED=1
fi

# 5. Run API route tests
echo "  • Running API route tests..."
if python -m pytest tests/test_all_routes.py::TestAPIRoutes -q --tb=no 2>/dev/null; then
    echo -e "${GREEN}  ✓ API tests passed${NC}"
else
    echo -e "${RED}  ✗ API tests failed${NC}"
    FAILED=1
fi

# 6. Check for uncommitted changes in critical files
echo "  • Checking critical file modifications..."
if git diff --cached --name-only | grep -q "requirements.txt"; then
    echo -e "${YELLOW}  ⚠ requirements.txt modified - ensure compatibility tested${NC}"
    if ! python scripts/validate_requirements.py >/dev/null 2>&1; then
        echo -e "${RED}  ✗ Requirements validation failed${NC}"
        FAILED=1
    fi
fi

if git diff --cached --name-only | grep -q "app/routes.py"; then
    echo -e "${YELLOW}  ⚠ app/routes.py modified - ensure all routes tested${NC}"
    if ! python -m pytest tests/test_all_routes.py::TestAPIRoutes -q --tb=no 2>/dev/null; then
        echo -e "${RED}  ✗ Route tests failed${NC}"
        FAILED=1
    fi
fi

if git diff --cached --name-only | grep -q "app/models.py"; then
    echo -e "${YELLOW}  ⚠ app/models.py modified - ensure models tested${NC}"
    if ! python -m pytest tests/test_accurate_comprehensive.py -q --tb=no 2>/dev/null; then
        echo -e "${RED}  ✗ Model tests failed${NC}"
        FAILED=1
    fi
fi

# 7. Check for incomplete functions (safety check)
echo "  • Checking for incomplete functions..."
INCOMPLETE=$(git diff --cached -U0 | grep -c "^@@.*@@$" || true)
if [ "$INCOMPLETE" -gt 0 ]; then
    # Check for functions that end without return statement
    if git diff --cached | grep -q "def.*:$" | grep -qv "return\|pass"; then
        echo -e "${YELLOW}  ⚠ Potential incomplete function definition detected${NC}"
    fi
fi

echo ""

# Final result
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-commit checks passed - commit allowed${NC}"
    exit 0
else
    echo -e "${RED}❌ Pre-commit checks failed - commit blocked${NC}"
    echo ""
    echo "💡 To fix:"
    echo "  1. Review the errors above"
    echo "  2. Run: python -m pytest tests/ -v"
    echo "  3. Run: python scripts/validate_requirements.py"
    echo "  4. Fix any issues"
    echo "  5. Try committing again"
    echo ""
    echo "⚠️  To skip (NOT RECOMMENDED): git commit --no-verify"
    exit 1
fi
